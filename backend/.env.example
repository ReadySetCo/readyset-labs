# ============================================
# Brand Intelligence Scraper - Environment Config
# ============================================
# Copy this file to .env and fill in your API keys

# LLM Provider: "openai" or "gemini"
LLM_PROVIDER=openai

# OpenAI API Key (required for analysis)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YOUR_KEY_HERE

# Google Gemini API Key (required for video analysis)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIzaSy-YOUR_KEY_HERE

# Firecrawl API Key (required for web scraping)
# Get from: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=fc-YOUR_KEY_HERE

# Apify API Token (required for social media scraping)
# Get from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=apify_api_YOUR_TOKEN_HERE

# ============================================
# Optional Configuration
# ============================================

# Database URL (default: SQLite in backend folder)
DATABASE_URL=sqlite+aiosqlite:///./database.db

# Scraping limits (reduce for lower costs)
MAX_POSTS_PER_SOURCE=100
MAX_REVIEWS_PER_SOURCE=100

# AnythingLLM legacy sync (disabled by default; direct chat is the active path)
ENABLE_ANYTHINGLLM_SYNC=false
# ANYTHINGLLM_API_KEY=

# Facebook credentials (optional - for cookie refresh)
# FB_EMAIL=
# FB_PASSWORD=

# Instagram credentials (optional)
# INSTAGRAM_USERNAME=
# INSTAGRAM_PASSWORD=
